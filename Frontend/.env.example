# Google Cloud project key with "Maps JavaScript API" + "Places API (New)" enabled and billing on.
# Restrict it to your domains (HTTP referrers). Leaving it blank disables the venue search + map.
VITE_GOOGLE_MAPS_API_KEY=<maps-js-and-places-key>
