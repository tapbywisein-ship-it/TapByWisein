# =============================================
# APPLICATION
# =============================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# =============================================
# DATABASE (Supabase Postgres)
# Replace <YOUR-DB-PASSWORD> and <region> (e.g. ap-south-1, us-east-1) with your project values from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# =============================================
DATABASE_URL=postgresql://postgres.zbkpsxzbyylbwvnsbcgq:4pKOsRMJhutQ6Nh1@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.zbkpsxzbyylbwvnsbcgq:4pKOsRMJhutQ6Nh1@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# =============================================
# REDIS (Optional in dev - falls back in-memory)
# =============================================
REDIS_URL=redis://localhost:6379

# =============================================
# JWT & BCRYPT
# =============================================
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-minimum-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# =============================================
# EMAIL (Resend)
# Get from https://resend.com/api-keys
# =============================================
