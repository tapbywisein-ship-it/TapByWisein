# =============================================
# APPLICATION
# =============================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# =============================================
# DATABASE (Supabase Postgres)
# Replace <YOUR-DB-PASSWORD> and <region> (e.g. ap-south-1, us-east-1) with your project values from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# =============================================
# Supabase Postgres connection. Get the full URI from the Supabase dashboard →
# Project Settings → Database → Connection string ("URI" format). Replace the
# project ref, region, and password with your project's values.
# NOTE: if the password contains special chars (e.g. @), URL-encode them (@ = %40).
# IMPORTANT (scale): set connection_limit so Prisma doesn't exhaust the Supabase
# pgbouncer pool. Prisma otherwise opens (num_cpus*2)+1 connections per process;
# with several instances that overruns the pooler and produces cryptic timeouts.
# Size it as (pgbouncer pool ÷ number of app instances). connection_limit=5 is a
# safe single-instance default; also add pool_timeout to fail fast under load.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public&connection_limit=5&pool_timeout=10
# Direct connection (used by Prisma migrate, NOT runtime queries — bypasses pgbouncer)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?schema=public

# =============================================
# REDIS (Optional in dev - falls back in-memory)
# =============================================
REDIS_URL=redis://localhost:6379

# =============================================
# JWT & BCRYPT
# =============================================
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-minimum-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# =============================================
# EMAIL (Resend)
# Get from https://resend.com/api-keys
# =============================================
RESEND_API_KEY=re_placeholder_for_dev
EMAIL_FROM=no-reply@tapbywisein.com
SUPPORT_EMAIL=tapbywisein@gmail.com

# =============================================
# CORS / FRONTEND
# =============================================
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# =============================================
# SUPABASE
# =============================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# =============================================
# RATE LIMITING & LOGGING
# =============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
LOG_LEVEL=info
LOG_DIR=logs
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif